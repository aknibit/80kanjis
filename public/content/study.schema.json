{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Contenido de estudio de japonés",
  "description": "Esquema de edición. Las referencias, identificadores únicos, lecturas emparejadas y cantidades ordenadas también se comprueban en CI.",
  "oneOf": [
    {
      "$ref": "#/$defs/navigation"
    },
    {
      "$ref": "#/$defs/counters"
    },
    {
      "$ref": "#/$defs/kana"
    },
    {
      "$ref": "#/$defs/lexicon"
    },
    {
      "$ref": "#/$defs/kanjiSentences"
    }
  ],
  "$defs": {
    "source": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "type": {
          "enum": [
            "vault",
            "attachment",
            "reference"
          ]
        },
        "path": {
          "type": "string",
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+\\.md$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "url": {
          "type": "string",
          "pattern": "^https://"
        }
      },
      "required": [
        "id",
        "label",
        "type"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "vault"
              }
            }
          },
          "then": {
            "required": [
              "path",
              "sha256"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "reference"
              }
            }
          },
          "then": {
            "required": [
              "url"
            ]
          }
        }
      ]
    },
    "group": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "inflection": {
          "description": "Solo en secciones léxicas: cómo se conjugan las entradas del grupo. Sus ejemplos muestran entonces las cuatro formas corteses, en orden.",
          "enum": [
            "i-adjective",
            "na-adjective"
          ]
        }
      },
      "required": [
        "id",
        "label"
      ],
      "additionalProperties": false
    },
    "example": {
      "type": "object",
      "description": "Frase corta: escritura, lectura en kana (sin kanji) y traducción.",
      "properties": {
        "written": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "reading": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[ぁ-ゖァ-ヶー\\s、。？！]+$"
        },
        "meaning": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "form": {
          "description": "Solo en entradas de un grupo con inflection: la forma con la que termina la frase. Van en este orden.",
          "enum": [
            "present-affirmative",
            "past-affirmative",
            "present-negative",
            "past-negative"
          ]
        }
      },
      "required": [
        "written",
        "reading",
        "meaning"
      ],
      "additionalProperties": false
    },
    "sentence": {
      "type": "object",
      "description": "Frase que escribe el kanji: escritura con bloques separados por espacios, lectura en kana con los mismos bloques y traducción.",
      "properties": {
        "written": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "reading": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[ぁ-ゖァ-ヶー\\s、。？！]+$"
        },
        "meaning": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      },
      "required": [
        "written",
        "reading",
        "meaning"
      ],
      "additionalProperties": false
    },
    "counterExample": {
      "type": "object",
      "description": "Uso real de la forma o la pregunta (example) o frase completa de uso diario (sentence): escritura con bloques separados por espacios, que incluye la forma; lectura en kana con los mismos bloques, que usa una de sus lecturas; y traducción. La frase termina en 。, ？ o ！.",
      "properties": {
        "written": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "reading": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[ぁ-ゖァ-ヶー\\s、。？！]+$"
        },
        "meaning": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      },
      "required": [
        "written",
        "reading",
        "meaning"
      ],
      "additionalProperties": false
    },
    "guide": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "sourceId": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "paragraphs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "minItems": 1,
          "maxItems": 5000
        },
        "examples": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/example"
          },
          "minItems": 1,
          "maxItems": 5000
        }
      },
      "required": [
        "id",
        "title",
        "sourceId",
        "paragraphs"
      ],
      "additionalProperties": false
    },
    "navigation": {
      "type": "object",
      "properties": {
        "$schema": {
          "type": "string"
        },
        "version": {
          "const": 1
        },
        "sections": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "kind": {
                "enum": [
                  "kanji",
                  "counters",
                  "kana",
                  "lexicon"
                ]
              },
              "file": {
                "type": "string",
                "pattern": "^(collection\\.json|content/[a-z0-9-]+\\.json)$"
              },
              "placement": {
                "enum": [
                  "primary",
                  "support"
                ]
              },
              "layout": {
                "const": "cards"
              }
            },
            "required": [
              "id",
              "label",
              "kind",
              "file"
            ],
            "additionalProperties": false,
            "allOf": [
              {
                "if": {
                  "properties": {
                    "kind": {
                      "const": "kanji"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "id": {
                      "const": "kanji"
                    },
                    "file": {
                      "const": "collection.json"
                    }
                  }
                },
                "else": {
                  "properties": {
                    "file": {
                      "pattern": "^content/[a-z0-9-]+\\.json$"
                    },
                    "id": {
                      "not": {
                        "const": "kanji"
                      }
                    }
                  }
                }
              },
              {
                "if": {
                  "required": [
                    "layout"
                  ]
                },
                "then": {
                  "properties": {
                    "kind": {
                      "const": "lexicon"
                    }
                  }
                }
              }
            ]
          },
          "minItems": 1,
          "maxItems": 5000,
          "prefixItems": [
            {
              "properties": {
                "id": {
                  "const": "kanji"
                },
                "kind": {
                  "const": "kanji"
                }
              }
            }
          ]
        }
      },
      "required": [
        "version",
        "sections"
      ],
      "additionalProperties": false
    },
    "counters": {
      "type": "object",
      "properties": {
        "$schema": {
          "type": "string"
        },
        "version": {
          "const": 1
        },
        "kind": {
          "const": "counters"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source"
          },
          "minItems": 1,
          "maxItems": 5000
        },
        "groups": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/group"
          },
          "minItems": 1,
          "maxItems": 5000
        },
        "guides": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/guide"
          },
          "minItems": 0,
          "maxItems": 5000
        },
        "entries": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
              },
              "group": {
                "type": "string",
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
              },
              "difficulty": {
                "description": "Dificultad de estudio del contador; la página filtra por ella junto con el grupo.",
                "enum": [
                  "easy",
                  "medium",
                  "hard"
                ]
              },
              "sourceId": {
                "type": "string",
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
              },
              "type": {
                "enum": [
                  "counter",
                  "number"
                ]
              },
              "written": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "endings": {
                "description": "Terminaciones en hiragana, de más a menos frecuentes entre las formas y la pregunta.",
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^[ぁ-ゖー]+$"
                },
                "minItems": 1,
                "maxItems": 20,
                "uniqueItems": true
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "description": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "notes": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "minItems": 0,
                "maxItems": 5000
              },
              "forms": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "value": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "written": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "\\S"
                    },
                    "readings": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1,
                        "pattern": "^[ぁ-ゖー\\s／/]+$"
                      },
                      "minItems": 1,
                      "maxItems": 5000,
                      "uniqueItems": true
                    },
                    "special": {
                      "type": "boolean"
                    },
                    "example": {
                      "$ref": "#/$defs/counterExample"
                    },
                    "sentence": {
                      "$ref": "#/$defs/counterExample"
                    }
                  },
                  "required": [
                    "value",
                    "written",
                    "readings",
                    "special",
                    "example",
                    "sentence"
                  ],
                  "additionalProperties": false
                },
                "minItems": 1,
                "maxItems": 5000
              },
              "question": {
                "type": "object",
                "properties": {
                  "written": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "\\S"
                  },
                  "readings": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "^[ぁ-ゖー\\s／/]+$"
                    },
                    "minItems": 1,
                    "maxItems": 5000
                  },
                  "example": {
                    "$ref": "#/$defs/counterExample"
                  },
                  "sentence": {
                    "$ref": "#/$defs/counterExample"
                  }
                },
                "required": [
                  "written",
                  "readings",
                  "example",
                  "sentence"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "id",
              "group",
              "difficulty",
              "sourceId",
              "type",
              "written",
              "endings",
              "title",
              "description",
              "notes",
              "forms",
              "question"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "maxItems": 5000
        },
        "editorialNotes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "minItems": 0,
          "maxItems": 5000
        }
      },
      "required": [
        "version",
        "kind",
        "title",
        "description",
        "sources",
        "groups",
        "guides",
        "entries"
      ],
      "additionalProperties": false
    },
    "kana": {
      "type": "object",
      "properties": {
        "$schema": {
          "type": "string"
        },
        "version": {
          "const": 1
        },
        "kind": {
          "const": "kana"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source"
          },
          "minItems": 1,
          "maxItems": 5000
        },
        "groups": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/group"
          },
          "minItems": 1,
          "maxItems": 5000
        },
        "guides": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/guide"
          },
          "minItems": 0,
          "maxItems": 5000
        },
        "entries": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
              },
              "group": {
                "type": "string",
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
              },
              "sourceId": {
                "type": "string",
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
              },
              "hiragana": {
                "type": "string",
                "pattern": "^[ぁ-ゖ]+$"
              },
              "katakana": {
                "type": "string",
                "pattern": "^[ァ-ヶ]+$"
              },
              "romaji": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "position": {
                "type": "object",
                "properties": {
                  "column": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 32
                  },
                  "row": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 15
                  }
                },
                "required": [
                  "column",
                  "row"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "id",
              "group",
              "sourceId",
              "hiragana",
              "katakana",
              "romaji",
              "position"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "maxItems": 5000
        }
      },
      "required": [
        "version",
        "kind",
        "title",
        "description",
        "sources",
        "groups",
        "guides",
        "entries"
      ],
      "additionalProperties": false
    },
    "lexicon": {
      "type": "object",
      "properties": {
        "$schema": {
          "type": "string"
        },
        "version": {
          "const": 1
        },
        "kind": {
          "const": "lexicon"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source"
          },
          "minItems": 1,
          "maxItems": 5000
        },
        "groups": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/group"
          },
          "minItems": 1,
          "maxItems": 5000
        },
        "guides": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/guide"
          },
          "minItems": 0,
          "maxItems": 5000
        },
        "entries": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
              },
              "group": {
                "type": "string",
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
              },
              "sourceId": {
                "type": "string",
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
              },
              "written": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "reading": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[ぁ-ゖー\\s／/]+$"
              },
              "romaji": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "meaning": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "note": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "examples": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/example"
                },
                "minItems": 1,
                "maxItems": 5000
              }
            },
            "required": [
              "id",
              "group",
              "sourceId",
              "written",
              "reading",
              "romaji",
              "meaning"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "maxItems": 5000
        }
      },
      "required": [
        "version",
        "kind",
        "title",
        "description",
        "sources",
        "groups",
        "guides",
        "entries"
      ],
      "additionalProperties": false
    },
    "kanjiSentences": {
      "type": "object",
      "description": "Frases de los 80 kanji para su ventana de información: dos sencillas y cuatro con adjetivos, adverbios y contadores. Solo usan palabras de la web.",
      "properties": {
        "$schema": {
          "type": "string"
        },
        "version": {
          "const": 1
        },
        "kind": {
          "const": "kanji-sentences"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "entries": {
          "type": "array",
          "description": "Un elemento por kanji de collection.json, en el mismo orden.",
          "items": {
            "type": "object",
            "properties": {
              "kanji": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1
              },
              "simple": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/sentence"
                },
                "minItems": 2,
                "maxItems": 2
              },
              "advanced": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/sentence"
                },
                "minItems": 4,
                "maxItems": 4
              }
            },
            "required": [
              "kanji",
              "simple",
              "advanced"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "maxItems": 5000
        }
      },
      "required": [
        "version",
        "kind",
        "description",
        "entries"
      ],
      "additionalProperties": false
    }
  }
}
